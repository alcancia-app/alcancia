# Ningún paquete corre scripts al instalarse (preinstall/postinstall): así se roban tokens en los ataques a la cadena de
# suministro. Capacitor y los plugins no los necesitan: `npm ci` + `npx cap sync` funcionan igual (probado).
ignore-scripts=true
# Versiones exactas al agregar algo (sin ^ ni ~), como en package.json.
save-exact=true
# Al instalar, avisa si algo tiene una vulnerabilidad conocida.
audit=true
