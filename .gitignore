# Lista blanca: solo se versiona lo listado.
/*
!/.gitignore
!/.github/
!/.claude/
!/bin/
!/ui/
!/docs/
!/recetas/
!/herramientas/
!/pruebas/
!/ejemplos/
!/escritorio/
!/movil/
!/build.sh
!/instalar.sh
# Pieza: la descripción de la app y las piezas que usa (las leen bin/nucleo.py y pieza.py).
!/app.json
!/piezas.json
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/LICENSE
escritorio/target/
escritorio/gen/
escritorio/vendor/
__pycache__/
.terminos-privados
capturas/
# Cartolas reales: nunca (las de prueba viven en pruebas/datos/)
*.xlsx
*.xls
*.csv
!/pruebas/datos/*.csv
*.ofx
*.qfx
*.qif
!/pruebas/datos/*.ofx
!/pruebas/datos/*.qif
*.xml
!/pruebas/datos/*.xml
!/docs/*.xml
# La app del celular: manifiestos y recursos de Android son XML (movil/.gitignore deja fuera lo que se arma o se baja)
!/movil/**/*.xml
*.pdf
!/pruebas/datos/*.pdf

# Pieza: archivos de la raíz que usa la app
!/acciones.json
